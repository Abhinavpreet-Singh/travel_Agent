{
  "$id": "travelomore/ontology/signal_dictionary",
  "version": "1.0.0",
  "updated_at": "2026-07-13",
  "description": "Canonical list of normalized ranking signals. Every persona weight key MUST exist here. Every raw attribute on an entity MUST map to exactly one signal. Engine contract: raw attribute -> normalizer -> signal value in [0,1] where 1 is always 'better for the traveller'.",
  "normalizer_types": {
    "index_100": "value / 100, clamped to [0,1]",
    "index_100_inverse": "1 - (value / 100), clamped to [0,1]",
    "linear_clamp": "(v - min) / (max - min), clamped to [0,1]",
    "linear_inverse_clamp": "1 - (v - min) / (max - min), clamped to [0,1]",
    "ratio": "value already in [0,1], clamped",
    "scale_1_5": "(v - 1) / 4",
    "scale_1_5_inverse": "1 - (v - 1) / 4",
    "boolean": "true -> 1, false -> 0",
    "enum_map": "explicit map from enum literal to [0,1]",
    "count_saturating": "1 - exp(-v / k), diminishing returns on counts"
  },
  "scopes": ["country", "city", "hotel", "activity", "flight", "visa"],
  "inheritance": {
    "chain": ["country", "city", "activity|hotel"],
    "rule": "A signal marked inheritable=true resolves bottom-up: entity value overrides parent value overrides country value. Non-inheritable signals must be present on the entity itself or are treated as missing (neutral prior + coverage penalty)."
  },
