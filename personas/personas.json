{
  "$id": "travelomore/personas",
  "version": "1.1.0",
  "updated_at": "2026-07-15",
  "contract": {
    "weights": "Keys MUST be signal ids from ontology/signal_dictionary.json. Values are relative weights; the engine renormalises over signals applicable to the entity type, so weights need not sum to exactly 100 after filtering.",
    "hard_gates": "Evaluated BEFORE scoring. If a gate fails, entity is marked eligible=false and excluded from ranking (not scored down). Gates are the difference between 'bad fit' and 'do not show'.",
    "soft_gates": "Fail => capped score. Used where the constraint is a warning not a blocker.",
    "tag_modifiers": "Applied after weighted score, bounded to +/- 0.12 on the 0..1 scale. Tags come from entity.tags.",
    "persona_stacking": "A trip can activate multiple personas (e.g. family_trip + infant_friendly). Engine composes them via weighted merge; see engine/score.js -> composePersonas()."
  },
  "personas": [
