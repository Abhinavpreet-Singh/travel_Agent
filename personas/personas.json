      "description": "Pregnant traveller (typically 2nd trimester travel window). Dominated by obstetric access, Zika/vector risk, heat stress, exertion limits, food/water hygiene, motion sickness and flight duration. Hard-gates high-risk activities outright.",
      "eligibility": {
        "trigger": "pregnant==true",
        "traveller_conditions": [
          "gestational_week >= 12",
          "gestational_week <= 28",
          "no_high_risk_flag"
        ]
      },
      "required_attributes": [
        "obstetric_care_access",
        "zika_risk_low",
        "food_hygiene",
