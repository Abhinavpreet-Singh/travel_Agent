{
  "$id": "https://schemas.travelomore.com/hotel.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travelomore Hotel File",
  "type": "object",
  "required": ["schema", "entities"],
  "properties": {
    "schema": { "const": "travelomore/hotel/1.0.0" },
    "notes": { "type": "string" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hotel" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hotel": {
      "type": "object",
      "required": ["id", "type", "name", "parent_id", "category", "star_rating", "price_inr_per_night", "room_types", "tags", "attributes", "meta"],
      "properties": {
        "id": { "type": "string", "pattern": "^hotel:[A-Z]{2}:[A-Z0-9]+:[a-z0-9-]+$" },
        "type": { "const": "hotel" },
        "name": { "type": "string" },
        "parent_id": { "type": "string", "pattern": "^city:[A-Z]{2}:[A-Z0-9]+$" },
        "category": { "type": "string" },
        "star_rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "price_inr_per_night": { "type": "number", "minimum": 0 },
        "room_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tags": { "$ref": "common.schema.json#/$defs/tags" },
        "attributes": { "$ref": "common.schema.json#/$defs/raw_attributes" },
        "persona_scores": { "$ref": "common.schema.json#/$defs/persona_scores_map" },
        "meta": { "$ref": "common.schema.json#/$defs/meta" },
        "validation": { "$ref": "common.schema.json#/$defs/validation" }
      },
      "additionalProperties": false
    }
  }
}
