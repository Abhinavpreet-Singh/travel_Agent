{
  "$id": "https://schemas.travelomore.com/city.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travelomore Destination City File",
  "type": "object",
  "required": ["schema", "parent", "entities"],
  "properties": {
    "schema": { "const": "travelomore/destination_city/1.0.0" },
    "parent": { "type": "string", "pattern": "^country:[A-Z]{2}$" },
    "notes": { "type": "string" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/destination_city" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "destination_city": {
      "type": "object",
      "required": ["id", "type", "name", "parent_id", "coordinates", "summary", "tags", "attributes", "meta"],
      "properties": {
        "id": { "type": "string", "pattern": "^city:[A-Z]{2}:[A-Z0-9]+$" },
        "type": { "const": "destination_city" },
        "name": { "type": "string" },
        "parent_id": { "type": "string", "pattern": "^country:[A-Z]{2}$" },
        "province": { "type": "string" },
        "coordinates": {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "additionalProperties": false
        },
        "gateway_airport": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{3}$" }
        },
        "summary": { "type": "string", "minLength": 20 },
        "best_months": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "avoid_months": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "tags": { "$ref": "common.schema.json#/$defs/tags" },
        "attributes": { "$ref": "common.schema.json#/$defs/raw_attributes" },
        "persona_scores": { "$ref": "common.schema.json#/$defs/persona_scores_map" },
        "meta": { "$ref": "common.schema.json#/$defs/meta" },
        "provenance": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/provenance_entry" }
        },
        "validation": { "$ref": "common.schema.json#/$defs/validation" }
      },
      "additionalProperties": false
    }
  }
}
