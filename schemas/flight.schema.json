{
  "$id": "https://schemas.travelomore.com/flight.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travelomore Flight Route File",
  "type": "object",
  "required": ["schema", "entities"],
  "properties": {
    "schema": { "const": "travelomore/flight/1.0.0" },
    "notes": { "type": "string" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/flight" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "flight": {
      "type": "object",
      "required": ["id", "type", "name", "parent_id", "origin_iata", "destination_iata", "is_direct", "airlines", "avg_price_inr_return_economy", "attributes", "meta"],
      "properties": {
        "id": { "type": "string", "pattern": "^flight:[A-Z]{2}:[A-Z]{3}-[A-Z]{3}$" },
        "type": { "const": "flight" },
        "name": { "type": "string" },
        "parent_id": { "type": "string", "pattern": "^country:[A-Z]{2}$" },
        "origin_iata": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "destination_iata": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "is_direct": { "type": "boolean" },
        "connection_point": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "airlines": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "avg_price_inr_return_economy": { "type": "number", "minimum": 0 },
        "tags": { "$ref": "common.schema.json#/$defs/tags" },
        "attributes": { "$ref": "common.schema.json#/$defs/raw_attributes" },
        "persona_scores": { "$ref": "common.schema.json#/$defs/persona_scores_map" },
        "meta": { "$ref": "common.schema.json#/$defs/meta" },
        "validation": { "$ref": "common.schema.json#/$defs/validation" }
      },
      "additionalProperties": false
    }
  }
}
